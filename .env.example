# SQLite database for missions, checklists and flight logs
DATABASE_URL="file:./dev.db"

# AI mission-planning agent (Claude). Required only for the copilot panel.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional: ADS-B Exchange via RapidAPI. Without it, the free adsb.lol API is used.
ADSBX_API_KEY=

# Optional overrides for FAA ArcGIS FeatureServer layers
FAA_UASFM_URL=https://services6.arcgis.com/ssFJjBXIUyZDrSYZ/arcgis/rest/services/FAA_UAS_FacilityMap_Data/FeatureServer/0/query
FAA_CLASS_AIRSPACE_URL=https://services6.arcgis.com/ssFJjBXIUyZDrSYZ/arcgis/rest/services/Class_Airspace/FeatureServer/0/query

# Optional map style (MapLibre style JSON URL). Default: CARTO Dark Matter (no key).
NEXT_PUBLIC_MAP_STYLE=

# LAANC submission adapter: "simulator" (default). Real USS adapters require a partner agreement.
LAANC_PROVIDER=simulator
