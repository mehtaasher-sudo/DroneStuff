<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FF22D3EE" android:endColor="#FF6366F1" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="17dp" android:bottom="17dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#66FFFFFF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
</layer-list>
